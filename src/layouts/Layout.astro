---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = '株式会社和福祉サービスは宮崎県小林市にてデイサービス・グループホームを運営しております。家族みたいなふれあいで安心して生活するための環境づくりのお手伝いをいたします。' } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | 株式会社和福祉サービス</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

<header class="site-header">
  <!-- 上段：電話・FAX -->
  <div class="header-topbar">
    <div class="header-topbar-inner">
      <span class="topbar-tel">📞 <a href="tel:0984-27-2820">0984-27-2820</a>　<span class="topbar-hours">営業時間 9:00〜19:00</span></span>
      <span class="topbar-fax">FAX: 0984-27-1670（24時間対応）</span>
    </div>
  </div>
  <!-- 下段：ロゴ＋ナビ -->
  <div class="header-inner">
    <a href="/" class="site-title">
      <span class="site-title-logo">和</span>
      <span class="site-title-text">
        株式会社和福祉サービス
        <small>宮崎県小林市のデイサービス・グループホーム</small>
      </span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" id="siteNav">
      <ul class="nav-list">
        <li><a href="/" class={pathname === '/' ? 'active' : ''}>ホーム</a></li>
        <li><a href="/dayservice" class={pathname.startsWith('/dayservice') ? 'active' : ''}>デイサービス</a></li>
        <li><a href="/grouphome" class={pathname.startsWith('/grouphome') ? 'active' : ''}>グループホーム</a></li>
        <li><a href="/nagomi-an" class={pathname.startsWith('/nagomi-an') ? 'active' : ''}>元気村なごみ庵</a></li>
        <li><a href="/care-plan-center" class={pathname.startsWith('/care-plan-center') ? 'active' : ''}>ケアプランセンター</a></li>
        <li><a href="/news" class={pathname.startsWith('/news') ? 'active' : ''}>新着情報</a></li>
        <li><a href="/training" class={pathname.startsWith('/training') ? 'active' : ''}>研修実績</a></li>
        <li><a href="/company" class={pathname.startsWith('/company') ? 'active' : ''}>会社概要</a></li>
        <li class="nav-new"><a href="/jobs" class={pathname.startsWith('/jobs') ? 'active' : ''}>求人票</a></li>
      </ul>
    </nav>
  </div>
  <div class="header-accent-line"></div>
</header>

<main>
  <slot />
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <h2>株式会社和福祉サービス</h2>
        <p>宮崎県小林市にて、デイサービス・グループホームを運営しております。家族みたいなふれあいで、安心して生活するための環境づくりのお手伝いをいたします。</p>
        <p class="footer-tel">📞 <a href="tel:0984-27-2820">0984-27-2820</a><span>（9:00〜19:00）</span></p>
      </div>
      <div class="footer-nav">
        <h3>サービス</h3>
        <ul>
          <li><a href="/dayservice">デイサービス</a></li>
          <li><a href="/grouphome">グループホーム</a></li>
          <li><a href="/nagomi-an" class={pathname.startsWith('/nagomi-an') ? 'active' : ''}>元気村なごみ庵</a></li>
        </ul>
      </div>
      <div class="footer-nav">
        <h3>情報</h3>
        <ul>
          <li><a href="/news">新着情報</a></li>
          <li><a href="/training">研修実績</a></li>
          <li><a href="/jobs">求人票</a></li>
          <li><a href="/company">会社概要</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2024 株式会社和福祉サービス. All rights reserved.</p>
    </div>
  </div>
</footer>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('siteNav');
  toggle?.addEventListener('click', () => nav?.classList.toggle('open'));
</script>

</body>
</html>
