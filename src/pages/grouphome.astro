      <div style="overflow-x:auto; margin-bottom:40px;">
        <table class="fee-table">
          <thead>
            <tr><th>項目</th><th>金額</th><th>備考</th></tr>
          </thead>
          <tbody>
            <tr><td>居室料金</td><td>23,000円／月</td><td></td></tr>
            <tr><td>食費</td><td>1,350円／日</td><td></td></tr>
