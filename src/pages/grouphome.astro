            <tr><td>オムツ処分料</td><td>70円／日</td></tr>
            <tr><td>電化製品持込み料</td><td>50円／月</td></tr>
            <tr><td>受診同行費用</td><td>500円／30分</td></tr>
            <tr><td>おむつ代・医療費・薬剤費</td><td>実費</td></tr>
