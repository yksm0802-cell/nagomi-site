---
import Layout from '../layouts/Layout.astro';
---
<Layout title="会社概要">

  <div class="page-hero">
    <h1>会社概要</h1>
    <p>株式会社和福祉サービスについて</p>
  </div>

  <!-- 会社写真 -->
  <section class="section section-alt" style="padding:32px 0;">
    <div class="container">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <img src="/images/company_img001.jpg" alt="株式会社和福祉サービス" style="width:100%; height:280px; object-fit:cover; border-radius:12px; box-shadow:var(--shadow);" />
        <img src="/images/company_img002.jpg" alt="株式会社和福祉サービス" style="width:100%; height:280px; object-fit:cover; border-radius:12px; box-shadow:var(--shadow);" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <table class="info-table">
        <tr><th>会社名</th><td>株式会社　和福祉サービス</td></tr>
        <tr><th>代表</th><td>小倉　和也</td></tr>
        <tr><th>住所</th><td>〒886-0005 宮崎県小林市大字南西方6257番地33</td></tr>
        <tr><th>電話番号</th><td><a href="tel:0984-27-2820">0984-27-2820</a></td></tr>
        <tr><th>FAX番号</th><td>0984-27-1670</td></tr>
        <tr><th>メール</th><td><a href="mailto:info@nagomi-fukushi.co.jp">info@nagomi-fukushi.co.jp</a></td></tr>
        <tr><th>営業時間</th><td>9:00〜19:00</td></tr>
        <tr><th>定休日</th><td>不定休</td></tr>
        <tr><th>アクセス</th><td>吉都線 西小林駅から車で3分 ／ 駐車場あり</td></tr>
        <tr><th>事業内容</th><td>地域密着型通所介護（デイサービス）、認知症対応型共同生活介護（グループホーム）、地域交流施設（元気村なごみ庵）</td></tr>
      </table>
    </div>
  </section>

  <!-- 基本理念 -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">基本理念</h2>
      <p class="section-subtitle">和福祉サービス地域密着型サービス 基本理念</p>
      <div class="card-grid">
        <div class="card">
          <div class="card-body">
            <div class="card-icon">🏘️</div>
            <h3>地域の寄りどころに</h3>
            <p>ホームが地域の寄りどころとなり、地域住民に愛される福祉拠点を目指します。</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="card-icon">🌿</div>
            <h3>寄り添いケアの実践</h3>
            <p>ゆっくり、ゆったりした時を過ごしていただくための、寄り添いケアを実践します。</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="card-icon">❤️</div>
            <h3>家庭的なサービス</h3>
            <p>地域の中でその人らしく暮らし、心も体も和んでいただけるよう、家庭的なサービスを提供します。</p>
          </div>
        </div>
      </div>
    </div>
  </section>


</Layout>
